<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgOrderMapper">
  <resultMap id="OrderResult" type="com.zjude.system.domain.ZjudgOrder"><id property="orderId" column="order_id"/><result property="orderNo" column="order_no"/><result property="serviceId" column="service_id"/><result property="serviceName" column="service_name"/><result property="userId" column="user_id"/><result property="userInfo" column="user_info"/><result property="appointmentDate" column="appointment_date"/><result property="slotId" column="slot_id"/><result property="slotName" column="slot_name"/><result property="amount" column="amount"/><result property="orderStatus" column="order_status"/><result property="paymentStatus" column="payment_status"/><result property="createTime" column="create_time"/></resultMap>
  <select id="selectList" resultMap="OrderResult">select order_id,order_no,service_id,service_name,user_id,user_info,appointment_date,slot_id,slot_name,amount,order_status,payment_status,create_time from zjudg_order <where><if test="orderNo != null and orderNo != ''">and order_no like concat('%',#{orderNo},'%')</if><if test="serviceName != null and serviceName != ''">and service_name like concat('%',#{serviceName},'%')</if><if test="userInfo != null and userInfo != ''">and user_info like concat('%',#{userInfo},'%')</if><if test="orderStatus != null and orderStatus != ''">and order_status=#{orderStatus}</if><if test="paymentStatus != null and paymentStatus != ''">and payment_status=#{paymentStatus}</if><if test="params.beginTime != null and params.beginTime != ''">and create_time &gt;= #{params.beginTime}</if><if test="params.endTime != null and params.endTime != ''">and create_time &lt; date_add(#{params.endTime},interval 1 day)</if></where> order by create_time desc</select>
  <select id="selectById" resultMap="OrderResult">select order_id,order_no,service_id,service_name,user_id,user_info,appointment_date,slot_id,slot_name,amount,order_status,payment_status,create_time from zjudg_order where order_id=#{id}</select>
</mapper>
