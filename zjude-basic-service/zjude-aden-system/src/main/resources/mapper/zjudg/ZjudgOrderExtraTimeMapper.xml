<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgOrderExtraTimeMapper">
  <resultMap id="ExtraTimeResult" type="com.zjude.system.domain.ZjudgOrderExtraTime">
    <id property="extraTimeId" column="extra_time_id"/>
    <result property="extraTimeNo" column="extra_time_no"/>
    <result property="orderId" column="order_id"/>
    <result property="userId" column="user_id"/>
    <result property="masterId" column="master_id"/>
    <result property="serviceId" column="service_id"/>
    <result property="serviceName" column="service_name"/>
    <result property="hours" column="hours"/>
    <result property="amount" column="amount"/>
    <result property="masterAmount" column="master_amount"/>
    <result property="paymentStatus" column="payment_status"/>
    <result property="paidTime" column="paid_time"/>
    <result property="createTime" column="create_time"/>
  </resultMap>
  <sql id="columns">extra_time_id,extra_time_no,order_id,user_id,master_id,service_id,service_name,hours,amount,master_amount,payment_status,paid_time,create_time</sql>
  <insert id="insert" parameterType="com.zjude.system.domain.ZjudgOrderExtraTime">
    insert into zjudg_order_extra_time(extra_time_id,extra_time_no,order_id,user_id,master_id,service_id,service_name,hours,amount,master_amount,payment_status,create_time)
    values(#{extraTimeId},#{extraTimeNo},#{orderId},#{userId},#{masterId},#{serviceId},#{serviceName},#{hours},#{amount},#{masterAmount},'0',sysdate())
  </insert>
  <select id="selectByIdAndUser" resultMap="ExtraTimeResult">
    select <include refid="columns"/> from zjudg_order_extra_time where extra_time_id=#{id} and user_id=#{userId}
  </select>
  <select id="selectById" resultMap="ExtraTimeResult">
    select <include refid="columns"/> from zjudg_order_extra_time where extra_time_id=#{id}
  </select>
  <select id="selectByOrderAndUser" resultMap="ExtraTimeResult">
    select <include refid="columns"/> from zjudg_order_extra_time where order_id=#{orderId} and user_id=#{userId} order by create_time desc
  </select>
  <update id="markPaid">
    update zjudg_order_extra_time set payment_status='1',paid_time=sysdate(),update_time=sysdate() where extra_time_id=#{id} and payment_status='0'
  </update>
</mapper>
