<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgServiceCategoryMapper">
  <resultMap id="CategoryResult" type="com.zjude.system.domain.ZjudgServiceCategory"><id property="categoryId" column="category_id"/><result property="parentId" column="parent_id"/><result property="categoryName" column="category_name"/><result property="imageUrl" column="image_url"/><result property="sortNum" column="sort_num"/><result property="homeRecommend" column="home_recommend"/><result property="status" column="status"/><result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/></resultMap>
  <select id="selectList" resultMap="CategoryResult">select category_id,parent_id,category_name,image_url,sort_num,home_recommend,status,create_by,create_time,update_by,update_time,remark from zjudg_service_category <where><if test="categoryName != null and categoryName != ''">and category_name like concat('%',#{categoryName},'%')</if><if test="status != null and status != ''">and status=#{status}</if><if test="homeRecommend != null and homeRecommend != ''">and home_recommend=#{homeRecommend}</if></where> order by sort_num asc,create_time desc</select>
  <select id="selectById" resultMap="CategoryResult">select category_id,parent_id,category_name,image_url,sort_num,home_recommend,status,create_by,create_time,update_by,update_time,remark from zjudg_service_category where category_id=#{id}</select>
  <insert id="insert">insert into zjudg_service_category(category_id,parent_id,category_name,image_url,sort_num,home_recommend,status,create_by,create_time,remark) values(#{categoryId},#{parentId},#{categoryName},#{imageUrl},#{sortNum},#{homeRecommend},#{status},#{createBy},sysdate(),#{remark})</insert>
  <update id="update">update zjudg_service_category set parent_id=#{parentId},category_name=#{categoryName},image_url=#{imageUrl},sort_num=#{sortNum},home_recommend=#{homeRecommend},status=#{status},update_by=#{updateBy},update_time=sysdate(),remark=#{remark} where category_id=#{categoryId}</update>
  <delete id="deleteByIds">delete from zjudg_service_category where category_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
