<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgServiceUnitMapper">
  <resultMap id="UnitResult" type="com.zjude.system.domain.ZjudgServiceUnit"><id property="unitId" column="unit_id"/><result property="unitName" column="unit_name"/><result property="measureType" column="measure_type"/><result property="sortNum" column="sort_num"/><result property="status" column="status"/><result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/></resultMap>
  <select id="selectList" resultMap="UnitResult">
    select unit_id,unit_name,measure_type,sort_num,status,create_by,create_time,update_by,update_time,remark
    from zjudg_service_unit
    <where>
      <if test="unitName != null and unitName != ''">and unit_name like concat('%',#{unitName},'%')</if>
      <if test="status != null and status != ''">and status=#{status}</if>
    </where>
    order by sort_num asc,create_time desc
  </select>
  <select id="selectById" resultMap="UnitResult">select unit_id,unit_name,measure_type,sort_num,status,create_by,create_time,update_by,update_time,remark from zjudg_service_unit where unit_id=#{id}</select>
  <insert id="insert">insert into zjudg_service_unit(unit_id,unit_name,measure_type,sort_num,status,create_by,create_time,remark) values(#{unitId},#{unitName},#{measureType},#{sortNum},#{status},#{createBy},sysdate(),#{remark})</insert>
  <update id="update">update zjudg_service_unit set unit_name=#{unitName},measure_type=#{measureType},sort_num=#{sortNum},status=#{status},update_by=#{updateBy},update_time=sysdate(),remark=#{remark} where unit_id=#{unitId}</update>
  <delete id="deleteByIds">delete from zjudg_service_unit where unit_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
