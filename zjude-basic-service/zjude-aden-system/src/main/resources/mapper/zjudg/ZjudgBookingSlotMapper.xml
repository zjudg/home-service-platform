<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgBookingSlotMapper">
  <resultMap id="SlotResult" type="com.zjude.system.domain.ZjudgBookingSlot">
    <id property="slotId" column="slot_id"/>
    <result property="slotName" column="slot_name"/>
    <result property="startTime" column="start_time"/>
    <result property="endTime" column="end_time"/>
    <result property="cityId" column="city_id"/>
    <result property="maxReserve" column="max_reserve"/>
    <result property="sortNum" column="sort_num"/>
    <result property="status" column="status"/>
    <result property="createBy" column="create_by"/>
    <result property="createTime" column="create_time"/>
    <result property="updateBy" column="update_by"/>
    <result property="updateTime" column="update_time"/>
  </resultMap>

  <sql id="columns">slot_id,slot_name,start_time,end_time,city_id,max_reserve,sort_num,status,create_by,create_time,update_by,update_time</sql>

  <select id="selectList" resultMap="SlotResult">
    select <include refid="columns"/> from zjudg_booking_slot
    <where>
      <if test="slotName != null and slotName != ''">and slot_name like concat('%',#{slotName},'%')</if>
      <if test="status != null and status != ''">and status=#{status}</if>
      <if test="cityId != null and cityId != ''">and (city_id is null or city_id = '' or city_id = #{cityId})</if>
    </where>
    order by sort_num asc,start_time asc
  </select>

  <!-- 严格城市过滤（zjudg.city.strict=1）：只返回该城市的专属时段，全国通用时段不参与 -->
  <select id="selectListByCity" resultMap="SlotResult">
    select <include refid="columns"/> from zjudg_booking_slot
    <where>
      <if test="slotName != null and slotName != ''">and slot_name like concat('%',#{slotName},'%')</if>
      <if test="status != null and status != ''">and status=#{status}</if>
      <if test="cityId != null and cityId != ''">and city_id = #{cityId}</if>
    </where>
    order by sort_num asc,start_time asc
  </select>

  <select id="selectById" resultMap="SlotResult">
    select <include refid="columns"/> from zjudg_booking_slot where slot_id=#{id}
  </select>

  <!-- 行锁：下单事务内串行化同一时段的容量校验，避免并发超卖 -->
  <select id="selectByIdForUpdate" resultMap="SlotResult">
    select <include refid="columns"/> from zjudg_booking_slot where slot_id=#{id} for update
  </select>

  <insert id="insert">
    insert into zjudg_booking_slot(slot_id,slot_name,start_time,end_time,city_id,max_reserve,sort_num,status,create_by,create_time)
    values(#{slotId},#{slotName},#{startTime},#{endTime},#{cityId},#{maxReserve},#{sortNum},#{status},#{createBy},sysdate())
  </insert>

  <update id="update">
    update zjudg_booking_slot
    set slot_name=#{slotName},start_time=#{startTime},end_time=#{endTime},city_id=#{cityId},
        max_reserve=#{maxReserve},sort_num=#{sortNum},status=#{status},
        update_by=#{updateBy},update_time=sysdate()
    where slot_id=#{slotId}
  </update>

  <delete id="deleteByIds">
    delete from zjudg_booking_slot where slot_id in
    <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
  </delete>
</mapper>
