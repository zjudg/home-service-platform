<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgBookingSlotMapper">
  <resultMap id="SlotResult" type="com.zjude.system.domain.ZjudgBookingSlot"><id property="slotId" column="slot_id"/><result property="slotName" column="slot_name"/><result property="startTime" column="start_time"/><result property="endTime" column="end_time"/><result property="maxReserve" column="max_reserve"/><result property="sortNum" column="sort_num"/><result property="status" column="status"/><result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/></resultMap>
  <select id="selectList" resultMap="SlotResult">select slot_id,slot_name,start_time,end_time,max_reserve,sort_num,status,create_by,create_time,update_by,update_time from zjudg_booking_slot <where><if test="slotName != null and slotName != ''">and slot_name like concat('%',#{slotName},'%')</if><if test="status != null and status != ''">and status=#{status}</if></where> order by sort_num asc,start_time asc</select>
  <select id="selectById" resultMap="SlotResult">select slot_id,slot_name,start_time,end_time,max_reserve,sort_num,status,create_by,create_time,update_by,update_time from zjudg_booking_slot where slot_id=#{id}</select>
  <insert id="insert">insert into zjudg_booking_slot(slot_id,slot_name,start_time,end_time,max_reserve,sort_num,status,create_by,create_time) values(#{slotId},#{slotName},#{startTime},#{endTime},#{maxReserve},#{sortNum},#{status},#{createBy},sysdate())</insert>
  <update id="update">update zjudg_booking_slot set slot_name=#{slotName},start_time=#{startTime},end_time=#{endTime},max_reserve=#{maxReserve},sort_num=#{sortNum},status=#{status},update_by=#{updateBy},update_time=sysdate() where slot_id=#{slotId}</update>
  <delete id="deleteByIds">delete from zjudg_booking_slot where slot_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
