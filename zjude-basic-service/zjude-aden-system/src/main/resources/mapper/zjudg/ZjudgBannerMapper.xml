<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgBannerMapper">

	<resultMap type="com.zjude.system.domain.ZjudgBanner" id="ZjudgBannerResult">
		<result property="seqNo"          column="seq_no"          />
		<result property="bannerId"       column="banner_id"       />
		<result property="bannerTitle"    column="banner_title"    />
		<result property="imageUrl"       column="image_url"       />
		<result property="linkType"       column="link_type"       />
		<result property="linkUrl"        column="link_url"        />
		<result property="bannerPosition" column="banner_position" />
		<result property="bannerSort"     column="banner_sort"     />
		<result property="status"         column="status"          />
		<result property="startTime"      column="start_time"      />
		<result property="endTime"        column="end_time"        />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectBannerVo">
        select banner_id, banner_title, image_url, link_type, link_url, banner_position, banner_sort, status, start_time, end_time, create_by, create_time, update_by, update_time, remark
		from zjudg_banner
    </sql>

	<select id="selectBannerList" parameterType="com.zjude.system.domain.ZjudgBanner" resultMap="ZjudgBannerResult">
		<include refid="selectBannerVo"/>
		<where>
			<if test="bannerTitle != null and bannerTitle != ''">
				AND banner_title like concat('%', #{bannerTitle}, '%')
			</if>
			<if test="bannerPosition != null and bannerPosition != ''">
				AND banner_position = #{bannerPosition}
			</if>
			<if test="linkType != null and linkType != ''">
				AND link_type = #{linkType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''">
				AND date_format(create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
			</if>
			<if test="params.endTime != null and params.endTime != ''">
				AND date_format(create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
			</if>
		</where>
		order by banner_position asc, banner_sort asc, create_time desc
	</select>

	<select id="selectBannerById" parameterType="String" resultMap="ZjudgBannerResult">
		<include refid="selectBannerVo"/>
		where banner_id = #{bannerId}
	</select>

	<!-- 小程序展示用：只取启用中且在有效期内的轮播图，起止时间为空表示不限 -->
	<select id="selectPublishedByPosition" parameterType="String" resultMap="ZjudgBannerResult">
		<include refid="selectBannerVo"/>
		where status = '0'
		  and banner_position = #{bannerPosition}
		  and (start_time is null or start_time &lt;= sysdate())
		  and (end_time is null or end_time &gt;= sysdate())
		order by banner_sort asc, create_time desc
	</select>

	<update id="updateBanner" parameterType="com.zjude.system.domain.ZjudgBanner">
		update zjudg_banner
		<set>
			<if test="bannerTitle != null and bannerTitle != ''">banner_title = #{bannerTitle},</if>
			<if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
			<if test="linkType != null and linkType != ''">link_type = #{linkType},</if>
			<if test="linkUrl != null">link_url = #{linkUrl},</if>
			<if test="bannerPosition != null and bannerPosition != ''">banner_position = #{bannerPosition},</if>
			<if test="bannerSort != null">banner_sort = #{bannerSort},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			start_time = #{startTime},
			end_time = #{endTime},
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where banner_id = #{bannerId}
	</update>

	<insert id="insertBanner" parameterType="com.zjude.system.domain.ZjudgBanner" useGeneratedKeys="true" keyProperty="seqNo">
		insert into zjudg_banner(
			<if test="bannerId != null and bannerId != ''">banner_id,</if>
			<if test="bannerTitle != null and bannerTitle != ''">banner_title,</if>
			<if test="imageUrl != null and imageUrl != ''">image_url,</if>
			<if test="linkType != null and linkType != ''">link_type,</if>
			<if test="linkUrl != null">link_url,</if>
			<if test="bannerPosition != null and bannerPosition != ''">banner_position,</if>
			<if test="bannerSort != null">banner_sort,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="startTime != null">start_time,</if>
			<if test="endTime != null">end_time,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="bannerId != null and bannerId != ''">#{bannerId},</if>
			<if test="bannerTitle != null and bannerTitle != ''">#{bannerTitle},</if>
			<if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
			<if test="linkType != null and linkType != ''">#{linkType},</if>
			<if test="linkUrl != null">#{linkUrl},</if>
			<if test="bannerPosition != null and bannerPosition != ''">#{bannerPosition},</if>
			<if test="bannerSort != null">#{bannerSort},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="startTime != null">#{startTime},</if>
			<if test="endTime != null">#{endTime},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<delete id="deleteBannerById" parameterType="String">
		delete from zjudg_banner where banner_id = #{bannerId,jdbcType=VARCHAR}
	</delete>

	<delete id="deleteBannerByIds" parameterType="String">
		delete from zjudg_banner where banner_id in
		<foreach collection="array" item="bannerId" open="(" separator="," close=")">
			#{bannerId,jdbcType=VARCHAR}
        </foreach>
	</delete>

</mapper>
