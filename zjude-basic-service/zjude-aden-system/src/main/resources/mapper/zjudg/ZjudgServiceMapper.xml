<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjude.system.mapper.ZjudgServiceMapper">
  <resultMap id="ServiceResult" type="com.zjude.system.domain.ZjudgService">
    <id property="serviceId" column="service_id"/><result property="serviceName" column="service_name"/><result property="serviceIntro" column="service_intro"/>
    <result property="categoryId" column="category_id"/><result property="categoryName" column="category_name"/><result property="carouselImages" column="carousel_images"/>
    <result property="price" column="price"/><result property="originalPrice" column="original_price"/><result property="unitId" column="unit_id"/><result property="unitName" column="unit_name"/>
    <result property="sortNum" column="sort_num"/><result property="status" column="status"/><result property="detailContent" column="detail_content"/><result property="reserveCount" column="reserve_count"/>
    <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
  </resultMap>
  <sql id="columns">s.service_id,s.service_name,s.service_intro,s.category_id,c.category_name,s.carousel_images,s.price,s.original_price,s.unit_id,u.unit_name,s.sort_num,s.status,s.detail_content,(select count(*) from zjudg_order o where o.service_id=s.service_id) reserve_count,s.create_by,s.create_time,s.update_by,s.update_time,s.remark</sql>
  <select id="selectList" resultMap="ServiceResult">select <include refid="columns"/> from zjudg_service s left join zjudg_service_category c on c.category_id=s.category_id left join zjudg_service_unit u on u.unit_id=s.unit_id
    <where><if test="serviceName != null and serviceName != ''">and s.service_name like concat('%',#{serviceName},'%')</if><if test="categoryId != null and categoryId != ''">and s.category_id=#{categoryId}</if><if test="status != null and status != ''">and s.status=#{status}</if></where> order by s.sort_num asc,s.create_time desc</select>
  <select id="selectById" resultMap="ServiceResult">select <include refid="columns"/> from zjudg_service s left join zjudg_service_category c on c.category_id=s.category_id left join zjudg_service_unit u on u.unit_id=s.unit_id where s.service_id=#{id}</select>
  <insert id="insert" parameterType="com.zjude.system.domain.ZjudgService">insert into zjudg_service(service_id,service_name,service_intro,category_id,carousel_images,price,original_price,unit_id,sort_num,status,detail_content,create_by,create_time,remark) values(#{serviceId},#{serviceName},#{serviceIntro},#{categoryId},#{carouselImages},#{price},#{originalPrice},#{unitId},#{sortNum},#{status},#{detailContent},#{createBy},sysdate(),#{remark})</insert>
  <update id="update" parameterType="com.zjude.system.domain.ZjudgService">update zjudg_service set service_name=#{serviceName},service_intro=#{serviceIntro},category_id=#{categoryId},carousel_images=#{carouselImages},price=#{price},original_price=#{originalPrice},unit_id=#{unitId},sort_num=#{sortNum},status=#{status},detail_content=#{detailContent},update_by=#{updateBy},update_time=sysdate(),remark=#{remark} where service_id=#{serviceId}</update>
  <delete id="deleteByIds">delete from zjudg_service where service_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>
