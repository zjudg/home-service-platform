FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nginx:1.27.0

LABEL MAINTAINER="MiaoJie"

ENV RUN_USER="nginx"

ENV RUN_GROUP="nginx"

ENV DATA_COMPANY_DIR="/data/web/company"

ENV DATA_MANAGEMENT_DIR="/data/web/management"

ENV LOG_DIR="/data/log/nginx"

RUN mkdir /data/log/nginx -p

RUN chown nginx:nginx -R /data/log/nginx

RUN rm -f /etc/nginx/conf.d/default.conf

ADD dist_company $DATA_COMPANY_DIR

ADD dist $DATA_MANAGEMENT_DIR

ADD conf/nginx.conf /etc/nginx/nginx.conf

ADD conf/default-prod.conf /etc/nginx/conf.d/default-prod.conf

EXPOSE 80

EXPOSE 443

ENTRYPOINT ["nginx", "-g", "daemon off;"]
