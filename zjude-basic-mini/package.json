{
  "name": "zjude-basic-mini",
  "version": "1.0.0",
  "private": true,
  "description": "Zjude Aden multi-platform uni-app client foundation",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni -p h5",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=. uni -p mp-weixin",
    "dev:app": "cross-env UNI_INPUT_DIR=. uni -p app",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build -p h5",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin",
    "build:app": "cross-env UNI_INPUT_DIR=. uni build -p app",
    "lint": "eslint . --ext .js,.vue --ignore-pattern node_modules --ignore-pattern dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-ui": "1.5.12",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@vue/compiler-sfc": "3.4.21",
    "cross-env": "7.0.3",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "sass": "1.77.8",
    "vite": "5.2.8",
    "vitest": "3.2.4"
  }
}
