{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/home/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/city/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/category/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/search/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/services/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/service-detail/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/booking/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/orders/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/order-detail/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/review/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/cart/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/user/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/address/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/address/edit/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/favorite/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/settings/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/certificates/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/legal/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/login/index", "style": { "navigationStyle": "custom" } }
  ],
  "subPackages": [
    {
      "root": "pages/master",
      "pages": [
        { "path": "home/index", "style": { "navigationStyle": "custom" } },
        { "path": "pool/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true } },
        { "path": "orders/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true } },
        { "path": "order-detail/index", "style": { "navigationStyle": "custom" } },
        { "path": "apply/index", "style": { "navigationStyle": "custom" } },
        { "path": "profile/index", "style": { "navigationStyle": "custom" } },
        { "path": "wallet/index", "style": { "navigationStyle": "custom" } }
      ]
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "Zjude Aden",
    "navigationBarBackgroundColor": "#faf7f5",
    "backgroundColor": "#faf7f5",
    "app-plus": { "background": "#faf7f5" }
  },
  "uniIdRouter": {}
}
